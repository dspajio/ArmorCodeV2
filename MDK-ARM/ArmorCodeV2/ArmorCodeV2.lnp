--cpu Cortex-M0+
"armorcodev2\startup_stm32g030xx.o"
"armorcodev2\main.o"
"armorcodev2\gpio.o"
"armorcodev2\adc.o"
"armorcodev2\tim.o"
"armorcodev2\stm32g0xx_it.o"
"armorcodev2\stm32g0xx_hal_msp.o"
"armorcodev2\stm32g0xx_hal_adc.o"
"armorcodev2\stm32g0xx_hal_adc_ex.o"
"armorcodev2\stm32g0xx_ll_adc.o"
"armorcodev2\stm32g0xx_hal_rcc.o"
"armorcodev2\stm32g0xx_hal_rcc_ex.o"
"armorcodev2\stm32g0xx_ll_rcc.o"
"armorcodev2\stm32g0xx_hal_flash.o"
"armorcodev2\stm32g0xx_hal_flash_ex.o"
"armorcodev2\stm32g0xx_hal_gpio.o"
"armorcodev2\stm32g0xx_hal_dma.o"
"armorcodev2\stm32g0xx_hal_dma_ex.o"
"armorcodev2\stm32g0xx_ll_dma.o"
"armorcodev2\stm32g0xx_hal_pwr.o"
"armorcodev2\stm32g0xx_hal_pwr_ex.o"
"armorcodev2\stm32g0xx_hal_cortex.o"
"armorcodev2\stm32g0xx_hal.o"
"armorcodev2\stm32g0xx_hal_exti.o"
"armorcodev2\stm32g0xx_hal_tim.o"
"armorcodev2\stm32g0xx_hal_tim_ex.o"
"armorcodev2\system_stm32g0xx.o"
--library_type=microlib --strict --scatter "ArmorCodeV2\ArmorCodeV2.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "ArmorCodeV2.map" -o ArmorCodeV2\ArmorCodeV2.axf